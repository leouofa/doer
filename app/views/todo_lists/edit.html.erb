<% content_for :title, "Edit #{@todo_list.title} — Doer" %>

<div class="max-w-3xl mx-auto space-y-6">
  <div class="flex items-center justify-between pb-4 border-b border-neutral-800">
    <div>
      <h1 class="text-xl font-bold tracking-tight text-white">Edit Todo List</h1>
      <p class="text-xs text-neutral-400 mt-1 font-mono">
        Update list details, project assignment, or markdown tasks
      </p>
    </div>
  </div>

  <%= render "form", todo_list: @todo_list %>
</div>
