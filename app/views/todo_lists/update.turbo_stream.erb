<%= turbo_stream.update "rendered_markdown_container" do %>
  <% if @todo_list.body.present? %>
    <%= render_markdown(@todo_list.body) %>
  <% else %>
    <div class="text-neutral-500 italic text-sm py-8 text-center font-mono">
      (Empty todo list. Click "Edit" or "Split" above to start writing.)
    </div>
  <% end %>
<% end %>
